{
  "name": "better-github",
  "version": "0.1.0",
  "private": true,
  "description": "An agent-native, Git-compatible code forge.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "better-sqlite3": "12.9.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
